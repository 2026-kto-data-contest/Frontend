{
  "rewrites": [
    {
      "source": "/recommended-courses/:path*",
      "destination": "https://jeontongjuro-backend.onrender.com/recommended-courses/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://jeontongjuro-backend.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
